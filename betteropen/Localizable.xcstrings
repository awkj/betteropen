      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开方式"
          }
        }
      }
    },
    "Retry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Opening mode selection is unavailable for this application.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用暂不支持指定窗口或标签页。"
          }
        }
      }
    },
    "Full Disk Access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全磁盘访问"
          }
        }
      }
    },
    "If a protected folder won’t open, enable access for BetterOpen in Settings, then restart the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若无法打开受保护文件夹，请在设置中为 BetterOpen 开启权限，然后重启应用。"
          }
        }
      }
    },
    "Open Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置…"
          }
        }
      }
    },
    "Appearance & Language": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观与语言"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Follow System": {
      "localizations": {
