      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 BetterOpen"
          }
        }
      }
    },
    "The configuration contains an invalid application.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置中包含无效的应用。"
          }
        }
      }
    },
    "The configuration contains duplicate applications.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置中包含重复的应用。"
          }
        }
      }
    },
    "This shortcut is already assigned to another application.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷键已分配给其他应用。"
          }
        }
      }
    },
    "This application is no longer available. Remove it and add its new location.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已不可用，请移除后从新位置重新添加。"
          }
        }
      }
    },
    "Shortcut for %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的快捷键"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "The configuration contains an invalid shortcut.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置中包含无效的快捷键。"
          }
        }
      }
    },
    "This configuration format is not supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此配置格式。"
          }
        }
      }
    },
    "Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder"
          }
        }
      }
    },
    "Show in Finder context menu": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在 Finder 右键菜单"
          }
        }
      }
    },
    "Enable Finder Extension…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Finder 扩展…"
          }
        }
      }
    },
    "Enable BetterOpen in Finder Extensions, then select Finder beside your apps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 扩展中启用 BetterOpen，然后勾选应用旁的 Finder。"
          }
        }
      }
    },
    "Open your apps from Finder or with a shortcut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Finder 或通过快捷键打开应用"
          }
        }
      }
    },
    "Add an application, then enable Finder or record a shortcut.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加应用，然后启用 Finder 菜单或录制快捷键。"
          }
        }
      }
    },
    "Open in %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 %@ 打开"
          }
        }
      }
    },
    "The selected file or folder is no longer available.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中的文件或文件夹已不存在。"
          }
        }
      }
    },
    "Unable to update the Finder menu. Reopen BetterOpen to retry.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新 Finder 菜单，请重新打开 BetterOpen 重试。"
          }
        }
      }
    },
    "The application could not open the folder (exit code %d).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用无法打开该目录（退出码 %d）。"
          }
        }
      }
    },
    "Shortcuts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键"
          }
        }
      }
    },
    "Finder Open": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 打开"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在 Finder"
          }
        }
      }
    },
    "Choose apps for the Finder context menu": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Finder 右键菜单中的应用"
          }
        }
      }
    },
    "Enable the BetterOpen Finder extension, then select the apps below. Menu order follows this list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 BetterOpen 的 Finder 扩展，然后勾选下方应用。菜单顺序与列表一致。"
          }
        }
      }
    },
    "Open files and folders in your apps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用指定应用打开文件与文件夹"
          }
        }
      }
    },
    "Add a terminal or editor, then enable its Finder menu item.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加终端或编辑器，然后启用它的 Finder 菜单。"
          }
        }
      }
    },
    "Remove this application?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此应用？"
          }
        }
      }
    },
    "This removes the application from both Shortcuts and Finder Open.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会同时移除该应用的快捷键和 Finder 菜单。"
          }
        }
      }
    },
    "Copy Path": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制路径"
          }
        }
      }
    },
    "Default Editor": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认编辑器"
          }
        }
      }
    },
    "Default Terminal": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认终端"
          }
        }
      }
    },
    "Finder Actions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 操作"
          }
        }
      }
    },
    "Installed apps are detected automatically. Choose Disabled to hide an action from Finder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测已安装的应用。选择“关闭”可隐藏对应的 Finder 菜单。"
          }
        }
      }
    },
    "Refresh Applications": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新应用"
          }
        }
      }
    },
    "Disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Preview settings are temporary. Enable the extension when using the installed app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览设置仅临时保存。正式使用时，请为已安装的应用启用扩展。"
          }
        }
      }
    },
    "%@ (Unavailable)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（未安装）"
          }
        }
      }
    },
    "This removes the application and its shortcut.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除该应用及其快捷键。"
          }
        }
      }
    },
    "BetterOpen Dev": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BetterOpen 开发版"
          }
        }
      }
    },
    "Enable BetterOpen Dev in Finder Extensions to test these settings. Your regular settings are separate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 扩展中启用 BetterOpen 开发版，即可测试这些设置。正式配置保持独立。"
          }
        }
      }
    },
    "This preview does not update Finder menus. Run just dev for an isolated Finder preview.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预览不会更新 Finder 菜单。运行 just dev 可启动独立的 Finder 预览。"
          }
        }
      }
    },
    "Quit BetterOpen Dev": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 BetterOpen 开发版"
          }
        }
      }
    },
    "Finder Extension": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 扩展"
          }
        }
      }
    },
    "Enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用"
          }
        }
      }
    },
    "Not Enabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未启用"
          }
        }
      }
    },
    "Finder menu update failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 菜单更新失败"
          }
        }
      }
    },
    "The extension is enabled. Right-click in Finder to use the selected actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展已启用，可在 Finder 右键菜单中使用所选操作。"
          }
        }
      }
    },
    "Enable this app in System Settings. The status updates automatically when you return.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中启用本应用的扩展，返回后会自动更新状态。"
          }
        }
      }
    },
    "Manage Finder Extension…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理 Finder 扩展…"
          }
        }
      }
