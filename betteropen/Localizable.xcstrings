      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发版与正式版的 Finder 配置相互独立。"
          }
        }
      }
    },
    "Enable Finder Extension": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Finder 扩展"
          }
        }
      }
