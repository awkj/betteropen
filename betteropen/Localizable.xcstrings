          }
        }
      }
    },
    "Terminal Opening Mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端打开方式"
          }
        }
      }
    },
    "New Window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新窗口"
          }
        }
      }
